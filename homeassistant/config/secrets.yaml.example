# Copia este fichero como secrets.yaml (queda fuera de git) y rellena tus valores.
# URLs de la API de la nube de los enchufes (ver packages/shelly.yaml).
shelly_get_url: https://<servidor-api>/v2/devices/api/get?auth_key=<clave>
shelly_set_url: https://<servidor-api>/v2/devices/api/set/switch?auth_key=<clave>
